# ---- CoEvolve Sandbox configuration (example) ----
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- LLM Providers ---
# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# OpenRouter (any provider via one key)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openrouter/auto

# Default provider used by the agent layer
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
LLM_SMALL_MODEL=claude-haiku-4-5

# --- Infrastructure ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/coevolve
REDIS_URL=redis://localhost:6379

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change-me