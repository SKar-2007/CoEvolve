# ---- CoEvolve API configuration ----
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Supabase PostgreSQL ---
# Get from: Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- LLM Provider (Groq free tier) ---
# Get from: console.groq.com > API Keys
GROQ_API_KEY=gsk_xxxx
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# --- Optional fallback providers ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- API ---
LOG_LEVEL=INFO

# --- Security ---
# Comma-separated allowed CORS origins ("*" = dev only, disables credentials).
# Production: set explicit origins, e.g. CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=*
# Set to true in production to require X-API-Key on mutating endpoints
REQUIRE_AUTH=false
# Key storage backend: "memory" (dev) or "db" (production — persisted in the
# api_keys table and shared across workers)
API_KEY_STORE=memory
# Bootstrap admin credential for production (generate with:
# python -c "import secrets; print('cov_' + secrets.token_urlsafe(32))").
# Only the hash is stored; the raw value is never logged.
# ADMIN_API_KEY=

# --- Redis (optional, falls back to in-memory queue) ---
# REDIS_URL=redis://localhost:6379/0
# UPSTASH_REDIS_URL=
# NOTE: REDIS_URL also enables the shared Redis rate limiter and is REQUIRED
# for the async /training/jobs path in multi-process deployments.

# --- Database pool (Postgres only; SQLite ignores these) ---
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Production secrets (required by docker-compose.prod.yml) ---
# POSTGRES_PASSWORD=change-me
# GRAFANA_PASSWORD=change-me
# POSTGRES_USER=coevolve
# POSTGRES_DB=coevolve
