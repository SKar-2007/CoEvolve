{
  "annotations": { "list": [] },
  "description": "CoEvolve security sandbox monitoring dashboard — tracks episodes, ELO ratings, exploit detection, LLM latency, and sandbox container health.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Episodes Completed",
      "description": "Total number of adversarial training episodes completed.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "coevolve_episodes_total",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "title": "Secure Rate",
      "description": "Proportion of episodes where the defender successfully neutralized the attack.",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - (rate(coevolve_vulnerabilities_detected_total[5m]) / rate(coevolve_episodes_total[5m]))",
          "legendFormat": "Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      }
    },
    {
      "title": "Attacker ELO",
      "description": "Current ELO rating of the attacker agent.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "coevolve_attacker_elo",
          "legendFormat": "Attacker",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Developer ELO",
      "description": "Current ELO rating of the developer (defender) agent.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "coevolve_developer_elo",
          "legendFormat": "Developer",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Distilled Rules",
      "description": "Number of security rules distilled from training episodes.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "coevolve_rules_distilled",
          "legendFormat": "Rules",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Episode Outcomes Over Time",
      "description": "Rate of completed episodes and discovered exploits over time.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(coevolve_episodes_total[5m])",
          "legendFormat": "Episodes/sec",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(coevolve_vulnerabilities_detected_total[5m])",
          "legendFormat": "Exploits/sec",
          "refId": "B"
        }
      ]
    },
    {
      "title": "LLM Latency (p50/p95/p99)",
      "description": "End-to-end LLM inference latency percentiles.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, rate(coevolve_llm_latency_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(coevolve_llm_latency_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, rate(coevolve_llm_latency_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Sandbox Container Status",
      "description": "Active sandbox containers and their resource usage.",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "coevolve_docker_containers_running",
          "legendFormat": "Active",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["coevolve", "security"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "CoEvolve Sandbox",
  "uid": "coevolve-main",
  "version": 1
}
