{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Episodes Completed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "coevolve_episodes_completed_total",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "title": "Secure Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "coevolve_secure_rate",
          "legendFormat": "Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      }
    },
    {
      "title": "Attacker ELO",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "coevolve_elo_attacker",
          "legendFormat": "Attacker",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Developer ELO",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "coevolve_elo_developer",
          "legendFormat": "Developer",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Distilled Rules",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "coevolve_rules_distilled_total",
          "legendFormat": "Rules",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Episode Outcomes Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(coevolve_episodes_completed_total[5m])",
          "legendFormat": "Episodes/sec",
          "refId": "A"
        },
        {
          "expr": "rate(coevolve_exploits_found_total[5m])",
          "legendFormat": "Exploits/sec",
          "refId": "B"
        }
      ]
    },
    {
      "title": "LLM Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "coevolve_llm_latency_seconds_bucket",
          "legendFormat": "p50",
          "refId": "A",
          "legendFormat": "{{le}}",
          "histogram_quantile": 0.5
        },
        {
          "expr": "histogram_quantile(0.95, coevolve_llm_latency_seconds_bucket)",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, coevolve_llm_latency_seconds_bucket)",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Sandbox Container Status",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "coevolve_sandbox_containers_active",
          "legendFormat": "Active",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["coevolve", "security"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "CoEvolve Sandbox",
  "uid": "coevolve-main",
  "version": 1
}
